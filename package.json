{
  "name": "mra-returns",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "test": "vitest run",
    "check:encoding": "node scripts/check-encoding.mjs",
    "check:build": "node scripts/check-build.mjs",
    "check:a11y": "node scripts/check-a11y.mjs",
    "check:bridge": "node scripts/check-bridge.mjs",
    "check:text": "node scripts/check-text.mjs",
    "check": "npm run check:encoding && npm run lint && npm run typecheck && npm test && npm run build && npm run check:build && npm run check:bridge && npm run check:a11y && npm run check:text",
    "prove": "node scripts/prove-tests-can-fail.mjs"
  },
  "dependencies": {
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@tailwindcss/vite": "4.3.3",
    "lucide-react": "1.52.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tailwindcss": "4.3.3",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "6.1.2",
    "oxlint": "1.87.0",
    "playwright": "1.63.0",
    "typescript": "6.0.3",
    "vite": "8.3.3",
    "vitest": "5.0.3"
  }
